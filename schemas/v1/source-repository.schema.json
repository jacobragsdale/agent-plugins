{
  "$defs": {
    "ListedSource": {
      "additionalProperties": false,
      "properties": {
        "description": { "maxLength": 1024, "minLength": 1, "type": "string" },
        "name": { "maxLength": 120, "minLength": 1, "type": "string" },
        "packageCount": { "description": "Marketplace listing: how many packages the source currently publishes.", "format": "uint32", "minimum": 0, "type": ["integer", "null"] },
        "publisher": { "description": "Marketplace listing: the publisher's display name.", "maxLength": 120, "minLength": 1, "type": ["string", "null"] },
        "sourceId": { "maxLength": 16, "minLength": 2, "type": ["string", "null"] },
        "updatedAt": { "description": "Marketplace listing: when the source archive last changed (RFC 3339).", "maxLength": 64, "minLength": 1, "type": ["string", "null"] },
        "url": { "type": "string" }
      },
      "required": ["name", "description", "url"],
      "type": "object"
    },
    "RepositoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "description": { "maxLength": 1024, "minLength": 1, "type": "string" },
        "id": { "maxLength": 32, "minLength": 2, "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9])){1,31}$", "type": "string" },
        "name": { "maxLength": 120, "minLength": 1, "type": "string" }
      },
      "required": ["id", "name", "description"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "repository": { "$ref": "#/$defs/RepositoryIdentity" },
    "sources": { "items": { "$ref": "#/$defs/ListedSource" }, "maxItems": 5000, "minItems": 0, "type": "array" },
    "version": { "maximum": 1, "minimum": 1, "type": "integer" }
  },
  "required": ["version", "repository", "sources"],
  "title": "RepositoryManifest",
  "type": "object"
}
